# ── dependencies ──
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── next.js build output ──
/.next/
/out/
/build

# ── testing ──
/coverage

# ── environment files ──
.env
.env.*
!.env.example

# ── local database & user uploads (demo data ships via prisma/seed.ts) ──
/db/*.db
/db/*.db-*
/db/*.sql
/db/backups/
/public/uploads/*
!/public/uploads/.gitkeep
/upload/
/download/

# ── logs ──
*.log
dev.log*
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── local ops artifacts (not part of the app) ──
/worklog.md
/.zscripts/
/examples/
/mini-services/
/tests/
/Caddyfile
supervisor.log*
.permanent-backups/

# ── local ops scripts (dev-server supervision, backups, one-off data tools) ──
/scripts/

# ── misc ──
.DS_Store
Thumbs.db
*.pem
*.pid
*.zip
.vercel
*.tsbuildinfo
next-env.d.ts
local-*
test
/skills/
/.trash-*/

# ── local agent/tooling artifacts (never publish) ──
/agent-ctx/
/tool-results/
