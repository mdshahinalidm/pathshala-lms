# ── PathShala LMS — environment variables ──────────────────────────────
# Copy this file to `.env` and adjust the values.

# SQLite database (local development).
# For production hosting (e.g. Vercel) use a hosted database — see deploy/VERCEL.md.
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (production — Vercel / Neon / Supabase):
# 1. bun run db:switch:postgres
# 2. point DATABASE_URL at your hosted Postgres and run db:push + db:seed
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Public URL of the site — used for SEO metadata, sitemap, robots and
# social share links. Set this to your production domain when deploying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign the session JWT. Generate one with:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# ── SMTP (optional) — contact-form / verification emails ───────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── SMS gateway (optional) — phone-number OTP login ────────────────────
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# Optional: extra origins allowed to fetch dev assets when viewing the
# site through a tunneling/proxy domain during development (comma-separated).
# DEV_ALLOWED_ORIGINS="my-tunnel.example.com"
